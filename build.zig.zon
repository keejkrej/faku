.{
    .name = .faku,
    .fingerprint = 0xd07ae10b5a707070,
    .version = "0.1.0",
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // Native 0.10.1 (CLI commit 064ca98). `native eject` wrote a
        // machine-local CLI path; pin the matching SDK tarball so
        // `native build --yes` / CI resolve without a host nvm path.
        .native_sdk = .{
            .url = "https://github.com/vercel-labs/native/archive/064ca9890cc0cf8adc198215bd0ddaeb586c220a.tar.gz",
            .hash = "native_sdk-0.1.0-hzDzQv7gsAKbt7-sBqYjdcRrOWbTxlvZS5dTbDG6tqpR",
        },
        // libghostty-vt: Ghostty's extracted terminal-state core, the
        // LAZY pin `terminal_sessions = true` resolves. Same commit/hash
        // as vercel-labs/native `examples/workbench` (verified).
        .ghostty = .{
            .url = "https://github.com/ghostty-org/ghostty/archive/7aa9591746ffa4d2eee458960c76554352832595.tar.gz",
            .hash = "ghostty-1.3.2-dev-5UdBC-edJAVXTdYsgHOzIqgAI7hE8VqpmriEi8zgufw2",
            .lazy = true,
        },
    },
    .paths = .{ "build.zig", "build.zig.zon", "src", "assets", "app.json" },
}
