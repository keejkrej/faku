<!-- Faku: Waku-shaped chrome — sidebar, header, transcript, queue, composer. -->
<column background="background">
  <split grow="1" value="{sidebar_split}" on-resize="sidebar_resized">
    <column min-width="{sidebar_pane_min}" background="surface_subtle">
      <row height="48" window-drag="true" cross="center" label="Sidebar titlebar">
        <button variant="ghost" size="icon" icon="panel-left" label="{sidebar_toggle_label}" on-press="toggle_sidebar"></button>
        <if test="{sidebar_expanded}">
          <spacer width="6" />
          <row gap="2" cross="center">
            <button variant="ghost" size="icon" icon="chevron-left" label="Back" on-press="history_back"></button>
            <button variant="ghost" size="icon" icon="chevron-right" label="Forward" on-press="history_forward"></button>
          </row>
          <spacer grow="1" />
        </if>
      </row>
      <if test="{sidebar_expanded}">
        <column padding="10" grow="1">
          <list-item height="32" on-press="new_session" label="New Task">
            <row gap="10" cross="center" padding="4">
              <icon name="edit" />
              <text>New Task</text>
            </row>
          </list-item>
          <if test="{search_active}">
            <row height="32" cross="center">
              <search-field grow="1" height="32" placeholder="Search" text="{search_query}" on-input="search_edit" autofocus="true" />
            </row>
          </if>
          <else>
            <list-item height="32" on-press="start_search" label="Search">
              <row gap="10" cross="center" padding="4">
                <icon name="search" />
                <text>Search</text>
              </row>
            </list-item>
          </else>
          <spacer height="10" />
          <row height="28" cross="center">
            <spacer width="8" />
            <list-item height="28" on-press="unassign_selected" label="Today">
              <text foreground="text_muted">Today</text>
            </list-item>
            <spacer grow="1" />
            <button variant="ghost" size="icon" icon="folder" label="New folder" on-press="new_folder"></button>
          </row>
          <spacer height="10" />
          <scroll grow="1">
            <column>
              <for each="sidebar_rows" key="id" as="s">
                <if test="{s.is_header}">
                  <list-item height="32" on-press="assign_selected:{s.folder_id}" label="{s.title}">
                    <row height="28" cross="center" padding="4">
                      <button variant="ghost" size="icon" icon="chevron-down" label="Collapse folder" on-press="toggle_folder:{s.folder_id}"></button>
                      <icon name="folder" />
                      <text foreground="text_muted">{s.title}</text>
                    </row>
                  </list-item>
                </if>
                <else>
                  <list-item height="52" selected="{s.selected}" on-press="select:{s.id}" label="{s.title}">
                    <column gap="2" padding="8">
                      <text>{s.title}</text>
                      <text foreground="text_muted">{s.provider}</text>
                    </column>
                  </list-item>
                </else>
              </for>
            </column>
          </scroll>
        </column>
        <row height="40" padding="10">
          <button variant="ghost" size="icon" icon="settings" label="Settings" on-press="toggle_settings"></button>
        </row>
      </if>
    </column>
    <column grow="1" min-width="360">
      <if test="{settings_open}">
        <row height="48" padding="14" gap="10" cross="center" window-drag="true" label="Toolbar">
          <text>Settings</text>
          <spacer grow="1" />
        </row>
        <separator />
        <scroll grow="1">
          <row grow="1" main="center">
            <column grow="1" max-width="720" gap="10" padding="14">
              <text>Default model</text>
              <text-field text="{settings_model}" placeholder="FX_MODEL" on-input="settings_model_edit" />
              <text>Access mode</text>
              <row gap="8">
                <button variant="ghost" size="sm" selected="{access_ask}" on-press="settings_access_ask">Ask</button>
                <button variant="ghost" size="sm" selected="{access_auto}" on-press="settings_access_auto">Auto</button>
                <button variant="ghost" size="sm" selected="{access_full}" on-press="settings_access_full">Full access</button>
              </row>
              <text>Last project path</text>
              <text-field text="{settings_project}" placeholder="Workspace path" on-input="settings_project_edit" />
              <text>Daemon address</text>
              <text-field text="{settings_daemon}" placeholder="host:port" on-input="settings_daemon_edit" />
            </column>
          </row>
        </scroll>
      </if>
      <else>
      <row height="48" padding="14" gap="10" cross="center" window-drag="true" label="Toolbar">
        <text>{header_title}</text>
        <spacer grow="1" />
        <if test="{can_rewind}">
          <button variant="ghost" size="sm" on-press="rewind">Rewind</button>
        </if>
        <button variant="ghost" size="icon" icon="x" label="Close" on-press="close_window"></button>
      </row>
      <separator />
      <scroll grow="1" value="{transcript_scroll}" on-scroll="transcript_scrolled">
        <row grow="1" main="center">
          <column grow="1" max-width="720" gap="8">
            <for each="visible_turns" key="id" as="t">
              <if test="{t.is_user}">
                <column gap="2" cross="end">
                  <text foreground="text_muted">{t.role_label}</text>
                  <bubble variant="primary">
                    <text wrap="true">{t.text}</text>
                  </bubble>
                </column>
              </if>
              <else>
                <if test="{t.is_tool}">
                  <column gap="2">
                    <text foreground="text_muted">{t.role_label}</text>
                    <text wrap="true" foreground="text_muted">{t.text}</text>
                  </column>
                </if>
                <else>
                  <column gap="2">
                    <text foreground="text_muted">{t.role_label}</text>
                    <text wrap="true">{t.text}</text>
                  </column>
                </else>
              </else>
            </for>
            <else>
              <column grow="1" gap="8" main="center" cross="center">
                <text size="heading">What should we build?</text>
              </column>
            </else>
          </column>
        </row>
      </scroll>
      <column padding="8">
        <row>
          <spacer width="12" />
          <column grow="1" max-width="720" gap="8">
            <if test="{has_queued}">
              <card size="sm" padding="10">
                <column gap="4">
                  <row gap="8" cross="center">
                    <text>Queued</text>
                    <spacer grow="1" />
                    <button size="sm" on-press="clear_queue">Dismiss</button>
                  </row>
                  <text wrap="true" foreground="text_muted">{queued_text}</text>
                </column>
              </card>
            </if>
            <input-group label="Message composer" height="88">
              <textarea placeholder="{composer_placeholder}" text="{draft}" submit-on-enter="true" on-input="draft_edit" on-submit="send" />
              <input-group-actions>
                <button variant="ghost" size="sm" icon="circle-dot" on-press="cycle_model">{model_label}</button>
                <button variant="ghost" size="sm" icon="menu">Medium</button>
                <button variant="ghost" size="sm" icon="eye" on-press="cycle_access">{access_label}</button>
                <button variant="ghost" size="sm" icon="wrench" on-press="cycle_interaction">{interaction_label}</button>
                <spacer grow="1" />
                <button variant="primary" size="icon" icon="arrow-up" label="{send_label}" on-press="send" width="26" height="26" radius="xl"></button>
              </input-group-actions>
            </input-group>
            <if test="{project_edit_active}">
              <row gap="8" cross="center">
                <text-field grow="1" placeholder="Workspace path" text="{project_edit}" on-input="project_path_edit" autofocus="true" />
                <spacer grow="1" />
                <progress value="{context_usage}" width="16" height="16" label="Context usage" />
              </row>
            </if>
            <else>
              <row gap="8" cross="center">
                <button variant="ghost" size="sm" icon="folder" on-press="start_project_edit">{project_label}</button>
                <if test="{project_is_local}">
                  <button variant="ghost" size="sm" icon="terminal" on-press="start_project_edit">Local</button>
                </if>
                <spacer grow="1" />
                <progress value="{context_usage}" width="16" height="16" label="Context usage" />
              </row>
            </else>
          </column>
          <spacer width="12" />
        </row>
      </column>
      </else>
    </column>
  </split>
</column>
