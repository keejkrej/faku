<!-- Faku: Waku-shaped chrome — sidebar, header, transcript, queue, composer. -->
<column background="background">
  <split grow="1" value="{sidebar_split}" on-resize="sidebar_resized">
    <column min-width="{sidebar_pane_min}" background="surface_subtle">
      <row height="48" window-drag="true" cross="center" label="Sidebar titlebar">
        <button variant="ghost" size="icon" icon="panel-left" label="{sidebar_toggle_label}" on-press="toggle_sidebar"></button>
        <if test="{sidebar_expanded}">
          <spacer width="6" />
          <row gap="2" cross="center">
            <button variant="ghost" size="icon" icon="chevron-left" label="Back" on-press="history_back"></button>
            <button variant="ghost" size="icon" icon="chevron-right" label="Forward" on-press="history_forward"></button>
          </row>
          <spacer grow="1" />
        </if>
      </row>
      <if test="{sidebar_expanded}">
        <column padding="10" grow="1">
          <list-item height="32" padding="8" gap="8" cross="center" on-press="new_session" label="New Task">
            <icon name="edit" width="14" height="14" />
            <text>New Task</text>
          </list-item>
          <list-item height="32" padding="8" gap="8" cross="center" on-press="start_search" label="Search">
            <icon name="search" width="14" height="14" />
            <text>Search</text>
          </list-item>
          <spacer height="10" />
          <row height="28" cross="center">
            <spacer width="8" />
            <list-item height="28" on-press="unassign_selected" label="Today">
              <!-- Unassign target (`folder_id` 0). Also the Today date bucket. -->
              <text foreground="text_muted">Today</text>
            </list-item>
            <spacer grow="1" />
            <if test="{can_collapse_folders}">
              <button variant="ghost" size="icon" icon="chevron-down" label="Collapse all folders" on-press="collapse_all_folders"></button>
            </if>
            <button variant="ghost" size="icon" icon="folder" label="New folder" on-press="new_folder"></button>
          </row>
          <spacer height="10" />
          <scroll grow="1">
            <column>
              <for each="sidebar_rows" key="id" as="s">
                <if test="{s.is_date_header}">
                  <!-- Date buckets use UTC civil days from updated_at
                       (Today / Yesterday / This week / This month / This year / Older).
                       The chrome Today list-item above stays the unassign target. -->
                  <row height="28" cross="center" padding="4">
                    <text foreground="text_muted">{s.title}</text>
                  </row>
                </if>
                <else>
                <if test="{s.is_header}">
                  <list-item height="32" padding="4" gap="6" cross="center" selected="{s.selected}" on-press="assign_selected:{s.folder_id}" label="{s.title}">
                    <if test="{s.collapsed}">
                      <button variant="ghost" size="icon" icon="chevron-right" label="Expand folder" on-press="toggle_folder:{s.folder_id}"></button>
                    </if>
                    <else>
                      <button variant="ghost" size="icon" icon="chevron-down" label="Collapse folder" on-press="toggle_folder:{s.folder_id}"></button>
                    </else>
                    <icon name="folder" />
                    <if test="{s.editing}">
                      <text-field grow="1" height="24" placeholder="New folder" text="{folder_title_draft}" on-input="folder_title_edit" autofocus="true" />
                    </if>
                    <else>
                      <text grow="1" wrap="false" overflow="ellipsis" foreground="text_muted">{s.title}</text>
                    </else>
                    <button variant="ghost" size="icon" icon="trash" label="Delete folder" on-press="delete_folder:{s.folder_id}"></button>
                    <context-menu>
                      <menu-item on-press="rename_folder:{s.folder_id}">Rename</menu-item>
                      <separator />
                      <menu-item on-press="delete_folder:{s.folder_id}">Delete</menu-item>
                    </context-menu>
                  </list-item>
                </if>
                <else>
                  <!-- Grouped folder children: 15px inset (Waku SIDEBAR_GROUP_GUIDE_X) + 1px
                       Native separator rail + 52px session card height. Today / ungrouped rows stay flush. -->
                  <if test="{s.grouped}">
                    <row height="52" cross="stretch">
                      <spacer width="15" />
                      <separator width="1" height="52"></separator>
                      <list-item height="52" grow="1" padding="8" gap="6" cross="center" selected="{s.selected}" on-press="select:{s.id}" label="{s.title}">
                        <column gap="4" grow="1">
                          <row gap="6" cross="center">
                            <if test="{s.editing}">
                              <text-field grow="1" height="24" placeholder="untitled" text="{session_title_draft}" on-input="session_title_edit" autofocus="true" />
                            </if>
                            <else>
                              <text grow="1" wrap="false" overflow="ellipsis">{s.title}</text>
                            </else>
                            <if test="{s.busy}">
                              <spinner width="12" height="12"></spinner>
                            </if>
                          </row>
                          <row gap="5" cross="center">
                            <icon name="folder" />
                            <text grow="1" wrap="false" overflow="ellipsis" foreground="text_muted">{s.provider}</text>
                            <if test="{s.has_relative_time}">
                              <text wrap="false" overflow="ellipsis" foreground="text_muted">{s.relative_time}</text>
                            </if>
                          </row>
                        </column>
                        <button variant="ghost" size="icon" icon="trash" label="Remove session" on-press="remove_session:{s.id}"></button>
                        <context-menu>
                          <menu-item on-press="rename_session:{s.id}">Rename</menu-item>
                          <separator />
                          <menu-item on-press="remove_session:{s.id}">Remove</menu-item>
                        </context-menu>
                      </list-item>
                    </row>
                  </if>
                  <else>
                    <list-item height="52" padding="8" gap="6" cross="center" selected="{s.selected}" on-press="select:{s.id}" label="{s.title}">
                      <column gap="4" grow="1">
                        <row gap="6" cross="center">
                          <if test="{s.editing}">
                            <text-field grow="1" height="24" placeholder="untitled" text="{session_title_draft}" on-input="session_title_edit" autofocus="true" />
                          </if>
                          <else>
                            <text grow="1" wrap="false" overflow="ellipsis">{s.title}</text>
                          </else>
                          <if test="{s.busy}">
                            <spinner width="12" height="12"></spinner>
                          </if>
                        </row>
                        <row gap="5" cross="center">
                          <icon name="folder" />
                          <text grow="1" wrap="false" overflow="ellipsis" foreground="text_muted">{s.provider}</text>
                          <if test="{s.has_relative_time}">
                            <text wrap="false" overflow="ellipsis" foreground="text_muted">{s.relative_time}</text>
                          </if>
                        </row>
                      </column>
                      <button variant="ghost" size="icon" icon="trash" label="Remove session" on-press="remove_session:{s.id}"></button>
                      <context-menu>
                        <menu-item on-press="rename_session:{s.id}">Rename</menu-item>
                        <separator />
                        <menu-item on-press="remove_session:{s.id}">Remove</menu-item>
                      </context-menu>
                    </list-item>
                  </else>
                </else>
                </else>
              </for>
            </column>
          </scroll>
        </column>
        <row height="40" padding="10">
          <button variant="ghost" size="icon" icon="settings" label="Settings" on-press="toggle_settings"></button>
        </row>
      </if>
    </column>
    <column grow="1" min-width="360">
      <if test="{settings_open}">
        <row height="48" padding="14" gap="10" cross="center" window-drag="true" label="Toolbar">
          <text>Settings</text>
          <spacer grow="1" />
        </row>
        <separator />
        <scroll grow="1">
          <row grow="1" main="center">
            <column grow="1" max-width="720" gap="10" padding="14">
              <text>Default model</text>
              <text-field text="{settings_model}" placeholder="FX_MODEL" on-input="settings_model_edit" />
              <text>Access mode</text>
              <row gap="8">
                <button variant="ghost" size="sm" selected="{access_ask}" on-press="settings_access_ask">Ask</button>
                <button variant="ghost" size="sm" selected="{access_auto}" on-press="settings_access_auto">Auto</button>
                <button variant="ghost" size="sm" selected="{access_full}" on-press="settings_access_full">Full access</button>
              </row>
              <text>Interaction</text>
              <row gap="8">
                <button variant="ghost" size="sm" selected="{interaction_build}" on-press="settings_interaction_build">Build</button>
                <button variant="ghost" size="sm" selected="{interaction_plan}" on-press="settings_interaction_plan">Plan</button>
              </row>
              <text>Effort</text>
              <stack>
                <select placeholder="Effort" on-press="toggle_settings_effort_picker">{settings_effort_label}</select>
                <if test="{settings_effort_picker_open}">
                  <dropdown-menu anchor="above" anchor-alignment="stretch" on-dismiss="close_settings_effort_picker">
                    <for each="settings_effort_picker_rows" key="row_id" as="e">
                      <menu-item selected="{e.selected}" on-press="pick_settings_effort:{e.id}">{e.label}</menu-item>
                    </for>
                  </dropdown-menu>
                </if>
              </stack>
              <text>Last project path</text>
              <text-field text="{settings_project}" placeholder="Workspace path" on-input="settings_project_edit" />
              <text>Daemon address</text>
              <text-field text="{settings_daemon}" placeholder="host:port" on-input="settings_daemon_edit" />
            </column>
          </row>
        </scroll>
      </if>
      <else>
      <row height="48" padding="14" gap="10" cross="center" window-drag="true" label="Toolbar">
        <if test="{session_title_editing}">
          <text-field grow="1" height="24" placeholder="untitled" text="{session_title_draft}" on-input="session_title_edit" autofocus="true" />
        </if>
        <else>
          <text grow="1" wrap="false" overflow="ellipsis" on-press="edit_session_title">{header_title}</text>
        </else>
        <spacer grow="1" />
        <button variant="ghost" size="icon" icon="copy" label="Copy session" on-press="copy_session"></button>
        <if test="{can_fork}">
          <button variant="ghost" size="sm" on-press="fork">Fork</button>
        </if>
        <if test="{can_rewind}">
          <button variant="ghost" size="sm" on-press="rewind">Rewind</button>
        </if>
      </row>
      <separator />
      <if test="{find_active}">
        <row height="32" padding="8" gap="6" cross="center">
          <search-field grow="1" height="32" placeholder="Find" text="{find_query}" on-input="find_edit" autofocus="true" label="Find in transcript" />
          <if test="{has_find_match_label}">
            <text wrap="false" overflow="ellipsis" foreground="text_muted">{find_match_label}</text>
          </if>
          <button variant="ghost" size="icon" icon="chevron-up" label="Previous match" on-press="find_prev"></button>
          <button variant="ghost" size="icon" icon="chevron-down" label="Next match" on-press="find_next"></button>
          <button variant="ghost" size="icon" icon="x" label="Close find" on-press="close_find"></button>
        </row>
      </if>
      <scroll grow="1" value="{transcript_scroll}" on-scroll="transcript_scrolled" label="Transcript">
        <column grow="1" padding="16" gap="12" cross="stretch" label="Conversation history">
          <for each="visible_turns" key="id" as="t">
            <if test="{t.is_user}">
              <row gap="8" label="{t.text}">
                <spacer grow="1" min-width="64" />
                <column gap="4" cross="end" label="You said">
                  <bubble variant="primary">
                    <text wrap="true">{t.text}</text>
                  </bubble>
                  <row gap="4" cross="center">
                    <button variant="ghost" size="icon" icon="copy" label="Copy" on-press="copy_turn:{t.id}"></button>
                    <button variant="ghost" size="sm" on-press="fork_turn:{t.id}">Fork</button>
                  </row>
                </column>
              </row>
            </if>
            <else>
              <if test="{t.is_tool}">
                <column gap="4" label="{t.text}">
                  <row gap="4" cross="center">
                    <text foreground="text_muted">{t.role_label}</text>
                    <button variant="ghost" size="icon" icon="copy" label="Copy" on-press="copy_turn:{t.id}"></button>
                    <button variant="ghost" size="sm" on-press="fork_turn:{t.id}">Fork</button>
                  </row>
                  <text wrap="true">{t.text}</text>
                </column>
              </if>
              <else>
                <if test="{t.is_reasoning}">
                  <column gap="4" label="{t.text}">
                    <row gap="4" cross="center">
                      <text foreground="text_muted">{t.role_label}</text>
                      <button variant="ghost" size="icon" icon="copy" label="Copy" on-press="copy_turn:{t.id}"></button>
                      <button variant="ghost" size="sm" on-press="fork_turn:{t.id}">Fork</button>
                    </row>
                    <text wrap="true">{t.text}</text>
                  </column>
                </if>
                <else>
                  <column gap="4" label="{t.text}">
                    <row gap="8" label="Assistant said">
                      <text wrap="true" grow="1">{t.text}</text>
                    </row>
                    <row gap="4" cross="center">
                      <button variant="ghost" size="icon" icon="copy" label="Copy" on-press="copy_turn:{t.id}"></button>
                      <button variant="ghost" size="sm" on-press="fork_turn:{t.id}">Fork</button>
                    </row>
                  </column>
                </else>
              </else>
            </else>
          </for>
          <else>
            <column grow="1" gap="8" padding="24" main="center" cross="center">
              <text size="display" text-alignment="center"><span weight="bold">What should we build?</span></text>
              <text foreground="text_muted" text-alignment="center">Pick a project, or just start typing.</text>
            </column>
          </else>
        </column>
      </scroll>
      <if test="{show_jump_latest}">
        <row main="center" padding="4">
          <button variant="ghost" size="sm" on-press="jump_latest">Jump to latest</button>
        </row>
      </if>
      <column padding="16" gap="8">
            <if test="{has_queued}">
              <card size="sm" padding="10">
                <column gap="4">
                  <row gap="8" cross="center">
                    <text>Queued</text>
                    <spacer grow="1" />
                    <button size="sm" on-press="clear_queue">Dismiss all</button>
                  </row>
                  <for each="queued_rows" key="id" as="q">
                    <list-item height="30" on-press="edit_queued:{q.id}" label="{q.text}">
                      <row gap="8" cross="center">
                        <text wrap="true" overflow="ellipsis" foreground="text_muted">{q.text}</text>
                        <button variant="ghost" size="icon" icon="x" label="Remove queued" on-press="remove_queued:{q.id}"></button>
                      </row>
                    </list-item>
                  </for>
                </column>
              </card>
            </if>
            <input-group grow="1" label="Message composer" height="88">
              <textarea placeholder="{composer_placeholder}" text="{draft}" submit-on-enter="true" on-input="draft_edit" on-submit="composer_enter" autofocus="{composer_active}" />
              <input-group-actions>
                <button variant="ghost" size="icon" icon="file-text" label="Attach image" on-press="pick_image"></button>
                <if test="{has_commands}">
                  <button variant="ghost" size="sm" selected="{commands_open}" on-press="toggle_commands">Commands</button>
                </if>
                <stack>
                  <button variant="ghost" size="sm" selected="{model_picker_open}" on-press="toggle_model_picker">{model_label}</button>
                  <if test="{model_picker_open}">
                    <dropdown-menu anchor="above" anchor-alignment="stretch" on-dismiss="close_model_picker">
                      <for each="model_picker_rows" key="row_id" as="m">
                        <menu-item selected="{m.selected}" on-press="pick_model:{m.id}">{m.label}</menu-item>
                      </for>
                    </dropdown-menu>
                  </if>
                </stack>
                <stack>
                  <button variant="ghost" size="sm" selected="{effort_picker_open}" on-press="toggle_effort_picker">{effort_label}</button>
                  <if test="{effort_picker_open}">
                    <dropdown-menu anchor="above" anchor-alignment="stretch" on-dismiss="close_effort_picker">
                      <for each="effort_picker_rows" key="row_id" as="e">
                        <menu-item selected="{e.selected}" on-press="pick_effort:{e.id}">{e.label}</menu-item>
                      </for>
                    </dropdown-menu>
                  </if>
                </stack>
                <stack>
                  <button variant="ghost" size="sm" selected="{access_picker_open}" on-press="toggle_access_picker">{access_label}</button>
                  <if test="{access_picker_open}">
                    <dropdown-menu anchor="above" anchor-alignment="stretch" on-dismiss="close_access_picker">
                      <for each="access_picker_rows" key="row_id" as="a">
                        <menu-item selected="{a.selected}" on-press="pick_access:{a.id}">{a.label}</menu-item>
                      </for>
                    </dropdown-menu>
                  </if>
                </stack>
                <button variant="ghost" size="sm" icon="wrench" on-press="cycle_interaction">{interaction_label}</button>
                <spacer grow="1" />
                <if test="{is_streaming}">
                  <button variant="primary" size="icon" icon="app:stop" label="Stop" on-press="stop_turn" width="26" height="26" radius="xl"></button>
                </if>
                <else>
                  <if test="{has_draft}">
                    <button variant="primary" size="icon" icon="arrow-up" label="Send" on-press="send" width="26" height="26" radius="xl"></button>
                  </if>
                  <else>
                    <button variant="secondary" size="icon" icon="arrow-up" label="Send" on-press="send" width="26" height="26" radius="xl"></button>
                  </else>
                </else>
              </input-group-actions>
            </input-group>
            <if test="{show_goal}">
              <row gap="8" cross="center">
                <text grow="1" wrap="false" overflow="ellipsis" foreground="text_muted">{goal_label}</text>
                <if test="{has_goal_usage}">
                  <text wrap="false" overflow="ellipsis" foreground="text_muted">{goal_usage_label}</text>
                </if>
                <stack>
                  <select placeholder="Status" on-press="toggle_goal_status_picker">{goal_status_label}</select>
                  <if test="{goal_status_picker_open}">
                    <dropdown-menu anchor="above" anchor-alignment="stretch" on-dismiss="close_goal_status_picker">
                      <for each="goal_status_picker_rows" key="row_id" as="g">
                        <menu-item selected="{g.selected}" on-press="pick_goal_status:{g.id}">{g.label}</menu-item>
                      </for>
                    </dropdown-menu>
                  </if>
                </stack>
                <button variant="ghost" size="sm" on-press="goal_set">Set goal</button>
                <button variant="ghost" size="sm" on-press="goal_clear">Clear goal</button>
                <button variant="ghost" size="sm" on-press="goal_refresh">Refresh goal</button>
              </row>
            </if>
            <if test="{image_attach_active}">
              <row gap="8" cross="center">
                <text-field grow="1" placeholder="Image path" text="{image_edit}" on-input="image_path_edit" autofocus="true" />
                <button variant="ghost" size="sm" on-press="pick_image">Pick image</button>
              </row>
            </if>
            <if test="{has_attach_status}">
              <text wrap="true" foreground="text_muted">{attach_status}</text>
            </if>
            <if test="{has_window_status}">
              <text wrap="true" foreground="text_muted">{window_status}</text>
            </if>
            <if test="{has_image_attach}">
              <row gap="4" cross="center">
                <if test="{has_image_preview}">
                  <image image="{attach_preview}" width="32" height="32" label="Attached image" />
                </if>
                <button variant="ghost" size="sm" icon="file-text" on-press="start_image_attach">{image_chip_label}</button>
                <button variant="ghost" size="icon" icon="x" label="Clear image" on-press="clear_image_attach"></button>
              </row>
            </if>
            <if test="{commands_list_open}">
              <card size="sm" padding="10">
                <column gap="2">
                  <for each="command_rows" key="id" as="c">
                    <list-item height="44" selected="{c.selected}" on-press="insert_command:{c.id}" label="{c.slash_name}">
                      <column gap="2" padding="4">
                        <text>{c.slash_name}</text>
                        <if test="{c.has_description}">
                          <text foreground="text_muted">{c.description}</text>
                        </if>
                      </column>
                    </list-item>
                  </for>
                </column>
              </card>
            </if>
            <if test="{mentions_list_open}">
              <card size="sm" padding="10">
                <column gap="2">
                  <for each="mention_rows" key="id" as="m">
                    <list-item height="44" selected="{m.selected}" on-press="insert_mention:{m.id}" label="{m.path}">
                      <column gap="2" padding="4">
                        <text>{m.name}</text>
                        <if test="{m.has_parent}">
                          <text foreground="text_muted">{m.parent}</text>
                        </if>
                      </column>
                    </list-item>
                  </for>
                </column>
              </card>
            </if>
            <if test="{git_branch_create_active}">
              <row gap="8" cross="center">
                <text-field grow="1" placeholder="New branch name" text="{git_branch_create}" on-input="git_branch_create_edit" autofocus="true" />
                <button variant="ghost" size="sm" on-press="confirm_git_branch_create">Create</button>
                <button variant="ghost" size="sm" on-press="cancel_git_branch_create">Cancel</button>
              </row>
            </if>
            <if test="{git_worktree_create_active}">
              <row gap="8" cross="center">
                <text-field grow="1" placeholder="New worktree name" text="{git_worktree_create}" on-input="git_worktree_create_edit" autofocus="true" />
                <button variant="ghost" size="sm" on-press="confirm_git_worktree_create">Create</button>
                <button variant="ghost" size="sm" on-press="cancel_git_worktree_create">Cancel</button>
              </row>
            </if>
            <if test="{git_commit_active}">
              <row gap="8" cross="center">
                <text-field grow="1" placeholder="Commit message" text="{git_commit}" on-input="git_commit_edit" autofocus="true" />
                <button variant="ghost" size="sm" on-press="confirm_git_commit">Commit</button>
                <button variant="ghost" size="sm" on-press="confirm_git_commit_and_push">Commit and Push</button>
                <button variant="ghost" size="sm" on-press="cancel_git_commit">Cancel</button>
              </row>
            </if>
            <if test="{git_branch_delete_active}">
              <row gap="8" cross="center">
                <stack>
                  <select placeholder="Branch" on-press="toggle_git_branch_delete_picker">{git_branch_delete}</select>
                  <if test="{git_branch_delete_picker_open}">
                    <dropdown-menu anchor="above" anchor-alignment="stretch" on-dismiss="close_git_branch_delete_picker">
                      <for each="git_branch_delete_rows" key="row_id" as="d">
                        <menu-item selected="{d.selected}" on-press="pick_git_branch_delete:{d.id}">{d.label}</menu-item>
                      </for>
                    </dropdown-menu>
                  </if>
                </stack>
                <button variant="ghost" size="sm" on-press="confirm_git_branch_delete">Delete</button>
                <button variant="ghost" size="sm" on-press="cancel_git_branch_delete">Cancel</button>
              </row>
            </if>
            <if test="{project_edit_active}">
              <row gap="8" cross="center">
                <text-field grow="1" placeholder="Workspace path" text="{project_edit}" on-input="project_path_edit" autofocus="true" />
                <button variant="ghost" size="sm" on-press="pick_folder">Pick folder</button>
                <if test="{can_reveal_folder}">
                  <button variant="ghost" size="sm" on-press="reveal_folder">Reveal folder</button>
                </if>
                <if test="{can_open_terminal}">
                  <button variant="ghost" size="sm" on-press="open_terminal">Open in Terminal</button>
                </if>
                <if test="{can_open_editor}">
                  <button variant="ghost" size="sm" on-press="open_editor">Open in Editor</button>
                </if>
                <if test="{can_copy_project_path}">
                  <button variant="ghost" size="sm" on-press="copy_project_path">Copy path</button>
                </if>
                <spacer grow="1" />
                <if test="{has_context_usage}">
                  <progress value="{context_usage}" width="48" height="6" label="Context usage" />
                </if>
              </row>
            </if>
            <else>
              <row gap="8" cross="center">
                <button variant="ghost" size="sm" icon="folder" on-press="start_project_edit">{project_label}</button>
                <if test="{can_reveal_folder}">
                  <button variant="ghost" size="sm" on-press="reveal_folder">Reveal folder</button>
                </if>
                <if test="{can_open_terminal}">
                  <button variant="ghost" size="sm" on-press="open_terminal">Open in Terminal</button>
                </if>
                <if test="{can_open_editor}">
                  <button variant="ghost" size="sm" on-press="open_editor">Open in Editor</button>
                </if>
                <if test="{can_copy_project_path}">
                  <button variant="ghost" size="sm" on-press="copy_project_path">Copy path</button>
                </if>
                <if test="{project_is_local}">
                  <button variant="ghost" size="sm" on-press="start_project_edit">Local</button>
                </if>
                <if test="{can_pick_git_branch}">
                  <stack>
                    <select size="sm" placeholder="Branch" on-press="toggle_git_branch_picker">{git_branch_label}</select>
                    <if test="{git_branch_picker_open}">
                      <dropdown-menu anchor="above" anchor-alignment="stretch" on-dismiss="close_git_branch_picker">
                        <menu-item on-press="start_git_branch_create">New branch…</menu-item>
                        <menu-item on-press="start_git_worktree_create">New worktree…</menu-item>
                        <if test="{can_delete_git_branch}">
                          <menu-item on-press="start_git_branch_delete">Delete branch…</menu-item>
                        </if>
                        <menu-item on-press="start_git_fetch">Fetch…</menu-item>
                        <if test="{can_commit_git}">
                          <menu-item on-press="start_git_commit">Commit…</menu-item>
                        </if>
                        <if test="{can_push_git_branch}">
                          <menu-item on-press="start_git_push">Push…</menu-item>
                        </if>
                        <for each="git_branch_picker_rows" key="row_id" as="b">
                          <menu-item selected="{b.selected}" on-press="pick_git_branch:{b.id}">{b.label}</menu-item>
                        </for>
                      </dropdown-menu>
                    </if>
                  </stack>
                </if>
                <if test="{has_git_dirty}">
                  <text wrap="false" overflow="ellipsis" foreground="text_muted">{git_dirty_label}</text>
                </if>
                <if test="{has_git_numstat}">
                  <text wrap="false" overflow="ellipsis" foreground="text_muted">{git_numstat_label}</text>
                </if>
                <if test="{has_git_ahead_behind}">
                  <text wrap="false" overflow="ellipsis" foreground="text_muted">{git_ahead_behind_label}</text>
                </if>
                <spacer grow="1" />
                <if test="{has_context_usage}">
                  <progress value="{context_usage}" width="48" height="6" label="Context usage" />
                </if>
              </row>
            </else>
      </column>
      </else>
    </column>
  </split>
  <if test="{palette_open}">
    <dialog text="Command palette" width="680" height="480" padding="16" on-dismiss="palette_cancel">
      <column gap="8">
        <spacer height="34"></spacer>
        <search-field grow="1" height="60" placeholder="Search" text="{search_query}" on-input="search_edit" autofocus="true" />
        <scroll grow="1">
          <column>
            <for each="palette_rows" key="id" as="r">
              <if test="{r.is_header}">
                <row height="30" cross="center">
                  <text foreground="text_muted">{r.label}</text>
                </row>
              </if>
              <else>
                <list-item height="44" selected="{r.selected}" on-press="palette_pick:{r.id}" on-submit="palette_pick:{r.id}" label="{r.label}">
                  <row gap="2" cross="center" padding="8">
                    <column gap="2" grow="1">
                      <text wrap="false" overflow="ellipsis">{r.label}</text>
                      <if test="{r.is_session}">
                        <text wrap="false" overflow="ellipsis" foreground="text_muted">{r.detail}</text>
                      </if>
                    </column>
                  </row>
                </list-item>
              </else>
            </for>
          </column>
        </scroll>
        <row gap="8" main="end">
          <button variant="ghost" on-press="palette_cancel">Cancel</button>
          <button variant="primary" on-press="palette_confirm">Confirm</button>
        </row>
      </column>
    </dialog>
  </if>
  <if test="{switcher_open}">
    <dialog text="Switch session" width="420" height="420" padding="16" on-dismiss="switcher_cancel">
      <column gap="8">
        <spacer height="34"></spacer>
        <scroll grow="1">
          <column>
            <for each="switcher_rows" key="id" as="s">
              <list-item height="52" selected="{s.selected}" on-press="switcher_pick:{s.id}" on-submit="switcher_pick:{s.id}" label="{s.title}">
                <row gap="2" cross="center" padding="8">
                  <column gap="2" grow="1">
                    <text wrap="false" overflow="ellipsis">{s.title}</text>
                    <text wrap="false" overflow="ellipsis" foreground="text_muted">{s.provider}</text>
                  </column>
                </row>
              </list-item>
            </for>
          </column>
        </scroll>
        <row gap="8" main="end">
          <button variant="ghost" on-press="switcher_cancel">Cancel</button>
          <button variant="primary" on-press="switcher_confirm">Switch</button>
        </row>
      </column>
    </dialog>
  </if>
</column>
