<!-- Faku: Waku-shaped chrome — sidebar, header, transcript, queue, composer. -->
<column background="background">
  <split grow="1" value="{sidebar_split}" on-resize="sidebar_resized">
    <column min-width="180" background="surface_subtle">
      <row height="48" window-drag="true" label="Sidebar titlebar">
        <spacer grow="1" />
      </row>
      <column padding="4" gap="10">
        <row height="32">
          <button size="sm" on-press="new_session">New Task</button>
        </row>
        <row height="32">
          <button size="sm">Search</button>
        </row>
        <text foreground="text_muted">Today</text>
      </column>
      <scroll grow="1">
        <column>
          <for each="session_rows" key="id" as="s">
            <list-item height="52" selected="{s.selected}" on-press="select:{s.id}" label="{s.title}">
              <column gap="2" padding="4">
                <text>{s.title}</text>
                <text foreground="text_muted">{s.provider}</text>
              </column>
            </list-item>
          </for>
        </column>
      </scroll>
    </column>
    <column grow="1" min-width="360">
      <row height="48" padding="12" gap="10" cross="center" window-drag="true" label="Toolbar">
        <text>{header_title}</text>
        <text foreground="text_muted">Faku</text>
        <spacer grow="1" />
        <button size="sm" on-press="new_session">New</button>
      </row>
      <separator />
      <scroll grow="1" value="{transcript_scroll}" on-scroll="transcript_scrolled">
        <row grow="1" main="center">
          <column grow="1" max-width="720" gap="8">
            <for each="visible_turns" key="id" as="t">
              <if test="{t.is_user}">
                <column gap="2" cross="end">
                  <text foreground="text_muted">{t.role_label}</text>
                  <bubble variant="primary">
                    <text wrap="true">{t.text}</text>
                  </bubble>
                </column>
              </if>
              <else>
                <if test="{t.is_tool}">
                  <column gap="2">
                    <text foreground="text_muted">{t.role_label}</text>
                    <text wrap="true" foreground="text_muted">{t.text}</text>
                  </column>
                </if>
                <else>
                  <column gap="2">
                    <text foreground="text_muted">{t.role_label}</text>
                    <text wrap="true">{t.text}</text>
                  </column>
                </else>
              </else>
            </for>
            <else>
              <column grow="1" gap="8" main="center" cross="center">
                <text size="heading">What should we build?</text>
              </column>
            </else>
          </column>
        </row>
      </scroll>
      <column padding="8">
        <row>
          <spacer width="12" />
          <column grow="1" max-width="720" gap="8">
            <if test="{has_queued}">
              <card size="sm" padding="10">
                <column gap="4">
                  <row gap="8" cross="center">
                    <text>Queued</text>
                    <spacer grow="1" />
                    <button size="sm" on-press="clear_queue">Dismiss</button>
                  </row>
                  <text wrap="true" foreground="text_muted">{queued_text}</text>
                </column>
              </card>
            </if>
            <input-group label="Message composer" height="88">
              <textarea placeholder="{composer_placeholder}" text="{draft}" submit-on-enter="true" on-input="draft_edit" on-submit="send" />
              <input-group-actions>
                <badge>{selected_provider}</badge>
                <badge>Full access</badge>
                <badge>Local</badge>
                <spacer grow="1" />
                <button variant="primary" on-press="send">{send_label}</button>
              </input-group-actions>
            </input-group>
          </column>
          <spacer width="12" />
        </row>
      </column>
    </column>
  </split>
  <status-bar>{status_line}</status-bar>
</column>
